<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BanjirWatch</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/minimalist.css" asp-append-version="true" />
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="nav-container">
                <a class="nav-brand" href="/">
                    <i class="fas fa-water"></i>
                    <span>BanjirWatch</span>
                </a>
                <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <ul class="nav-menu" id="navMenu">
                    <li><a class="nav-link" href="/">Home</a></li>
                    <li><a class="nav-link" href="/Posts">Feed</a></li>
                    <li><a class="nav-link" href="/Map">Map</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li><a class="nav-link" href="/Posts/Create">
                            <i class="fas fa-plus-circle"></i> Report
                        </a></li>
                        <li class="nav-dropdown">
                            <button class="nav-link dropdown-toggle">
                                <img src="@(User.FindFirst("AvatarPath")?.Value ?? "/images/default-avatar.svg")" 
                                     alt="Avatar" class="nav-avatar" 
                                     onerror="this.src='/images/default-avatar.svg'" />
                                <span>@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a href="/Auth/Profile">Profile</a></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline;">
                                        <button type="submit" class="dropdown-item">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li><a class="nav-link nav-link-primary" href="/Auth/Login">Login</a></li>
                        <li><a class="nav-link nav-link-primary" href="/Auth/Register">Register</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main class="main-container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade-in">
                @TempData["SuccessMessage"]
                <button type="button" class="alert-close" onclick="this.parentElement.remove()">&times;</button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error alert-dismissible fade-in">
                @TempData["ErrorMessage"]
                <button type="button" class="alert-close" onclick="this.parentElement.remove()">&times;</button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; @DateTime.Now.Year BanjirWatch - Community Flood Reporting</p>
        </div>
    </footer>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
