@model BanjirWatch.Models.ViewModels.MapViewModel
@{
    ViewData["Title"] = "Map";
}

<div class="map-section">
    <div style="max-width: 1400px; margin: 0 auto; padding: 0 2rem 2rem;">
        <div class="section-header" style="padding: 0 0 1.5rem;">
            <span class="section-icon">🗺️</span>
            <h2>Flood Map</h2>
        </div>
    </div>
    
    <div class="map-container" style="margin: 0 2rem;">
        <div class="map-toolbar">
            <div class="map-search">
                <input type="text" id="searchInput" placeholder="Search location..." onkeypress="if(event.key==='Enter') searchLocation()">
                <button class="btn btn-primary" onclick="searchLocation()">
                    <i class="fas fa-search"></i>
                </button>
                <button class="btn btn-secondary" onclick="locateMe()">
                    <i class="fas fa-crosshairs"></i> My Location
                </button>
            </div>
            
            <div class="map-legend">
                <div class="legend-item">
                    <div class="legend-dot" style="background-color: #ef4444;"></div>
                    <span>Severe</span>
                </div>
                <div class="legend-item">
                    <div class="legend-dot" style="background-color: #f97316;"></div>
                    <span>High</span>
                </div>
                <div class="legend-item">
                    <div class="legend-dot" style="background-color: #f59e0b;"></div>
                    <span>Moderate</span>
                </div>
                <div class="legend-item">
                    <div class="legend-dot" style="background-color: #22c55e;"></div>
                    <span>Low</span>
                </div>
                <div class="legend-item">
                    <div class="legend-dot" style="background-color: #0ea5e9;"></div>
                    <span>User Report</span>
                </div>
            </div>
        </div>

        <div id="map" style="height: 500px; width: 100%;"></div>
    </div>
</div>

@section Scripts {
    <script>
        let map;
        let markers = [];
        let currentLocationMarker = null;

        document.addEventListener('DOMContentLoaded', function() {
            initMap();
            loadFloodPoints();
            setTimeout(locateMe, 1000);
        });

        function initMap() {
            map = L.map('map').setView([@Model.CenterLatitude, @Model.CenterLongitude], @Model.Zoom);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 19
            }).addTo(map);
        }

        async function loadFloodPoints() {
            try {
                const response = await fetch('/Map/GetFloodPoints');
                if (!response.ok) throw new Error('Failed to load flood points');
                
                const points = await response.json();
                
                markers.forEach(m => map.removeLayer(m));
                markers = [];
                
                points.forEach(point => {
                    const marker = createMarker(point);
                    markers.push(marker);
                });
                
                console.log(`Loaded ${points.length} flood points`);
            } catch (error) {
                console.error('Error loading flood points:', error);
            }
        }

        function createMarker(point) {
            let iconHtml, popupContent;
            
            if (point.type === 'api') {
                const severity = point.severity || 0;
                let color = severity >= 75 ? '#ef4444' : 
                           severity >= 50 ? '#f97316' : 
                           severity >= 25 ? '#f59e0b' : '#22c55e';
                
                iconHtml = `<div style="width: 24px; height: 24px; background-color: ${color}; border-radius: 50%; border: 3px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.3);"></div>`;
                
                popupContent = `
                    <div style="min-width: 200px; font-family: var(--font-body);">
                        <h4 style="margin: 0 0 0.5rem; font-family: var(--font-heading); color: ${color};">
                            <i class="fas fa-exclamation-triangle"></i> Flood Risk: ${severity}%
                        </h4>
                        <p style="margin: 0 0 0.5rem; font-size: 0.9rem; color: var(--text-dark);">${point.description}</p>
                        <p style="margin: 0; font-size: 0.75rem; color: var(--text-muted);">
                            ${new Date(point.createdAt).toLocaleString()}
                        </p>
                    </div>
                `;
                
                const icon = L.divIcon({
                    html: iconHtml,
                    className: 'custom-div-icon',
                    iconSize: [24, 24],
                    iconAnchor: [12, 12]
                });
                
                const marker = L.marker([point.latitude, point.longitude], { icon }).addTo(map);
                marker.bindPopup(popupContent);
                return marker;
                
            } else {
                iconHtml = `<div style="width: 32px; height: 32px; background-color: #0ea5e9; border-radius: 50%; border: 3px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.75rem;"><i class="fas fa-user"></i></div>`;
                
                popupContent = `
                    <div style="min-width: 220px; font-family: var(--font-body);">
                        <h4 style="margin: 0 0 0.5rem; font-family: var(--font-heading); color: var(--text-dark);">${point.title}</h4>
                        ${point.imagePath ? `<img src="${point.imagePath}" style="width: 100%; height: 120px; object-fit: cover; border-radius: 8px; margin-bottom: 0.5rem; border: 2px solid var(--border-light);">` : ''}
                        <p style="margin: 0 0 0.5rem; font-size: 0.9rem; color: var(--text-dark);">${point.description}</p>
                        <a href="/Posts/Details/${point.id}" style="font-size: 0.875rem; color: var(--primary-coral); font-weight: 600; text-decoration: none;">View Report →</a>
                    </div>
                `;
                
                const icon = L.divIcon({
                    html: iconHtml,
                    className: 'custom-div-icon',
                    iconSize: [32, 32],
                    iconAnchor: [16, 16]
                });
                
                const marker = L.marker([point.latitude, point.longitude], { icon }).addTo(map);
                marker.bindPopup(popupContent);
                return marker;
            }
        }

        function locateMe() {
            if (!navigator.geolocation) {
                alert('Geolocation is not supported by your browser');
                return;
            }

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;
                    
                    if (currentLocationMarker) {
                        map.removeLayer(currentLocationMarker);
                    }
                    
                    const iconHtml = `<div style="width: 20px; height: 20px; background-color: #3b82f6; border-radius: 50%; border: 3px solid white; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.3);"></div>`;
                    const icon = L.divIcon({
                        html: iconHtml,
                        className: 'custom-div-icon',
                        iconSize: [20, 20],
                        iconAnchor: [10, 10]
                    });
                    
                    currentLocationMarker = L.marker([lat, lng], { icon }).addTo(map);
                    currentLocationMarker.bindPopup('<strong style="font-family: var(--font-heading);">You are here</strong>');
                    
                    map.setView([lat, lng], 14);
                    
                    checkFloodRisk(lat, lng);
                },
                (error) => {
                    console.warn('Geolocation error:', error);
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
            );
        }

        async function checkFloodRisk(lat, lng) {
            try {
                const response = await fetch(`/Map/CheckLocation?lat=${lat}&lon=${lng}`);
                if (!response.ok) return;
                
                const data = await response.json();
                if (data.error) return;
                
                let riskColor = data.severity >= 60 ? '#ef4444' : 
                               data.severity >= 30 ? '#f59e0b' : '#22c55e';
                
                if (currentLocationMarker) {
                    currentLocationMarker.bindPopup(`
                        <div style="min-width: 180px; font-family: var(--font-body);">
                            <strong style="font-family: var(--font-heading); display: block; margin-bottom: 0.5rem;">You are here</strong>
                            <hr style="margin: 0.5rem 0; border: none; border-top: 1px solid var(--border-light);">
                            <p style="margin: 0; font-size: 0.9rem; color: var(--text-dark);">
                                <strong>Risk Level:</strong> 
                                <span style="color: ${riskColor}; font-weight: 700;">${data.riskLevel}</span>
                            </p>
                            <p style="margin: 0.25rem 0 0; font-size: 0.75rem; color: var(--text-muted);">
                                ${data.description}<br>
                                Precipitation: ${data.precipitation}mm
                            </p>
                        </div>
                    `);
                }
            } catch (error) {
                console.warn('Could not check flood risk:', error);
            }
        }

        async function searchLocation() {
            const query = document.getElementById('searchInput').value.trim();
            if (!query) return;

            try {
                const response = await fetch(`/Map/SearchLocation?query=${encodeURIComponent(query)}`);
                if (!response.ok) throw new Error('Search failed');
                
                const results = await response.json();
                
                if (results.length === 0) {
                    alert('Location not found. Try a different search term.');
                    return;
                }
                
                const location = results[0];
                map.setView([location.lat, location.lon], 13);
                
                const marker = L.marker([location.lat, location.lon]).addTo(map);
                marker.bindPopup(`<strong style="font-family: var(--font-heading);">${location.name}</strong>`).openPopup();
                
                setTimeout(() => map.removeLayer(marker), 5000);
                
            } catch (error) {
                console.error('Search error:', error);
                alert('Search failed. Please try again.');
            }
        }

        setInterval(loadFloodPoints, 5 * 60 * 1000);
    </script>
}
