@model BanjirWatch.Models.User
@{
    ViewData["Title"] = "Profile";
}

<div class="profile-header">
    <img src="@(Model.AvatarPath ?? "/images/default-avatar.svg")" alt="@Model.Username" class="profile-avatar">
    <div class="profile-info">
        <h2>@Model.Username</h2>
        <p>@Model.Email</p>
        <p class="text-muted">Joined @Model.CreatedAt.ToString("MMMM yyyy")</p>
        <div class="profile-stats">
            <div class="profile-stat">
                <div class="profile-stat-value">@Model.Posts.Count</div>
                <div class="profile-stat-label">Reports</div>
            </div>
            <div class="profile-stat">
                <div class="profile-stat-value">@Model.Likes.Count</div>
                <div class="profile-stat-label">Likes</div>
            </div>
            <div class="profile-stat">
                <div class="profile-stat-value">@Model.Comments.Count</div>
                <div class="profile-stat-label">Comments</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Update Avatar</h3>
    </div>
    <div class="card-body">
        <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <div class="file-input-wrapper">
                    <input type="file" name="avatar" id="avatarInput" accept="image/*" onchange="previewImage(this, 'avatarPreview')" />
                    <label for="avatarInput" class="file-input-label">
                        <i class="fas fa-camera"></i>
                        <span>Choose Photo</span>
                    </label>
                </div>
                <img id="avatarPreview" style="display: none; max-width: 200px; margin-top: 1rem; border-radius: var(--radius);" />
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-upload"></i> Upload Avatar
            </button>
        </form>
    </div>
</div>

@if (Model.Posts.Any())
{
    <section class="mt-3">
        <h3 class="mb-2">My Reports</h3>
        <div class="posts-container">
            @foreach (var post in Model.Posts.OrderByDescending(p => p.CreatedAt))
            {
                <article class="post-card">
                    @if (!string.IsNullOrEmpty(post.ImagePath))
                    {
                        <img src="@post.ImagePath" alt="" class="post-image">
                    }
                    <div class="post-content">
                        <p class="post-text">@post.Content</p>
                        @if (!string.IsNullOrEmpty(post.LocationName))
                        {
                            <div class="post-location">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>@post.LocationName</span>
                            </div>
                        }
                        <div class="post-time">@post.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                    <div class="post-actions">
                        <span class="post-action">
                            <i class="fas fa-heart"></i>
                            <span>@post.Likes.Count</span>
                        </span>
                        <span class="post-action">
                            <i class="fas fa-comment"></i>
                            <span>@post.Comments.Count</span>
                        </span>
                        <form asp-controller="Posts" asp-action="Delete" asp-route-id="@post.Id" method="post" style="margin-left: auto;" onsubmit="return confirm('Are you sure you want to delete this post?');">
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    </section>
}
