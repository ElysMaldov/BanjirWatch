@{
    ViewData["Title"] = "Privacy Policy";
}

<div style="max-width: 800px; margin: 0 auto;">
    <h1>Privacy Policy</h1>
    
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-body">
            <h2>Data Collection</h2>
            <p>BanjirWatch collects the following information:</p>
            <ul>
                <li><strong>Account Information:</strong> Username, email address, and password (hashed)</li>
                <li><strong>Posts:</strong> Content, images, and location data you voluntarily share</li>
                <li><strong>Usage Data:</strong> Basic analytics to improve the service</li>
            </ul>

            <h2>How We Use Your Data</h2>
            <p>We use your data to:</p>
            <ul>
                <li>Provide flood reporting and monitoring services</li>
                <li>Display your posts and location on the map</li>
                <li>Send notifications about flood risks in your area</li>
                <li>Improve our weather data accuracy</li>
            </ul>

            <h2>Location Data</h2>
            <p>Your location data is used to:</p>
            <ul>
                <li>Mark flood reports on the map</li>
                <li>Show nearby flood alerts</li>
                <li>Provide relevant weather information</li>
            </ul>
            <p>You can control location sharing when creating posts.</p>

            <h2>Data Storage</h2>
            <p>Your data is stored securely in our database. Images are stored locally on our servers.</p>

            <h2>Third-Party Services</h2>
            <p>We use the following third-party services:</p>
            <ul>
                <li><strong>OpenStreetMap:</strong> For map tiles</li>
                <li><strong>Open-Meteo:</strong> For weather and flood risk data</li>
            </ul>

            <h2>Contact</h2>
            <p>If you have any questions about this privacy policy, please contact us through the platform.</p>
        </div>
    </div>
</div>
